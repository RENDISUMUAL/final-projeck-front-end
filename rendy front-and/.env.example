# Salin ke .env.local lalu isi API key dari dashboard penyedia AI.
# Jangan awali variabel ini dengan VITE_; variabel VITE_* dikirim ke browser.
# Ambil Gemini API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional: webhook Production dari n8n bisa diisi dari panel konfigurasi chatbot.
# Jika ingin menjadi nilai default, isi URL n8n di bawah lalu mulai ulang Vite.
VITE_N8N_CHAT_WEBHOOK_URL=
