{
  "name": "Smart Zoo Chatbot",
  "nodes": [
    {
      "parameters": {
        "public": false,
        "allowedOrigins": "*",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "chat-trigger-node",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "webhookId": "smart-zoo-chatbot"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "Kamu adalah asisten Smart Zoo berbahasa Indonesia. Bantu pengguna mencari dan menjelaskan data satwa, habitat, dan jadwal perawatan kebun binatang. Gunakan hanya data yang diberikan untuk pertanyaan terkait kebun binatang; jika tidak ada, katakan bahwa data tidak ditemukan.\n\nData website:\n{{ $json.websiteData ? JSON.stringify($json.websiteData) : 'Tidak ada data website.' }}\n\nRiwayat percakapan:\n{{ $json.history ? JSON.stringify($json.history) : 'Belum ada.' }}"
        }
      },
      "id": "ai-agent-node",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [220, 0]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "openai-model-node",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [220, 220]
    },
    {
      "parameters": {},
      "id": "memory-node",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [340, 220]
    },
    {
      "parameters": {},
      "id": "respond-node",
      "name": "Respond to Chat",
      "type": "@n8n/n8n-nodes-langchain.chat",
      "typeVersion": 1.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Chat Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Simple Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}
